flowchart LR
  subgraph CLIENT["01 · INPUT & BROWSER"]
    direction TB
    INPUTS["Research paper<br/>PDF or TXT<br/><br/>Repository<br/>Source files · ZIP · public Git URL"]
    UI["Bio-Audit web UI<br/>Choose inputs · run audit<br/>Review findings"]
    INPUTS --> UI
  end

  subgraph INTAKE["02 · API & TEMPORARY INTAKE"]
    direction TB
    API["FastAPI backend<br/>POST /api/audit"]
    CHECK["Validate file types, sizes<br/>and public Git URL"]
    TEMP["Temporary workspace<br/>Paper + repository source<br/>Public Git fetched to temp only"]
    API --> CHECK --> TEMP
  end

  subgraph ENGINE["03 · EXISTING BIO-AUDIT ANALYZER"]
    direction TB
    CLAIMS["Extract paper claims<br/>Parameter values · named methods"]
    SCAN["Scan repository source<br/>Constants · method calls · evidence locations"]
    COMPARE["Compare claims and code facts<br/>Assign one of 9 verdicts"]
    SAFETY["SAFETY BOUNDARY<br/>Repository code is never executed<br/>No install · build · tests · scripts · benchmark"]
    CLAIMS --> COMPARE
    SCAN --> COMPARE
    COMPARE --- SAFETY
  end

  subgraph OUTPUT["04 · REPORT & REVIEW"]
    direction TB
    REPORT["Structured report<br/>Verdicts · evidence · metadata"]
    REVIEW["Browser findings view<br/>Search · filters · detail pane<br/>JSON / HTML export"]
    CLEANUP["Temporary inputs discarded"]
    REPORT --> REVIEW
    REPORT -.-> CLEANUP
  end

  UI --> API
  TEMP --> CLAIMS
  TEMP --> SCAN
  COMPARE --> REPORT

